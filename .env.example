# Copy this file to .env (same folder) for the click-to-edit preview: npm run preview:edit
# .env is ignored by git; never commit a real token.
#
# A Viewer token: sanity.io/manage > Forró Budapest > API > Tokens > Add API token,
# permissions "Viewer". It lets the preview read unpublished drafts.
SANITY_VIEWER_TOKEN=

---
// The frame around every page: head tags, header with menu and language switch, footer.
// `section` decides which menu is shown: the community level or the festival below it.
import '@fontsource-variable/fraunces/index.css';
import '@fontsource-variable/libre-franklin/index.css';
import '@fontsource-variable/open-sans/index.css';
import '../styles/global.css';
import { getSite, getPalette, knownColour, getFestival, getCommunity, getPages, getFestivalMenuLink, getImage, safeUrl, href, trFirst, editAttr, withBase } from '../lib/content';
import { LANGS, LANG_LABEL, LANG_NAME, UI, tr, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  section: 'community' | 'festival';
  /** Address without the language, e.g. "/festival/program/". Used for the menu and the language switch. */
  pagePath: string;
  title?: string;
  description?: string;
  /** Photo for link previews on social media (a Sanity image or a path like /uploads/x.jpg). */
  shareImage?: unknown;
  /** Background of the page body: red (default), dark or cream. */
  /** The page colour: a colour id from the palette. */
  tone?: string;
}

const { lang, section, pagePath, title, description, shareImage, tone = 'red' } = Astro.props;
const site = getSite();
const festival = getFestival();
const community = getCommunity();
const t = UI[lang];
const inFestival = section === 'festival';

const sectionName = inFestival ? festival.name : site.name;
const fullTitle = title ? `${title} | ${sectionName}` : sectionName;
const desc = description || tr(inFestival ? festival : site, 'tagline', lang);
const canonical = new URL(href(lang, pagePath), Astro.site).href;
const share = getImage(shareImage || (inFestival ? festival.heroImage : community.heroImage) || festival.heroImage);
const shareUrl = share ? new URL(share.src, Astro.site).href : '';

// The menu: the section's pages marked "Show in the menu", in their menu order. In the
// community menu the button to the festival is a community page set to "goes to the
// festival", with its own name and order; without one, a festival button comes first.
const menuPages = getPages(section)
  .filter((p) => p.showInMenu)
  .map((p) => ({ path: p.path, label: trFirst(p, ['menuLabel', 'title'], lang), order: p.order }));
const festivalLink = getFestivalMenuLink();
const festivalItem = festivalLink
  ? festivalLink.showInMenu
    ? [{ path: '/festival/', label: trFirst(festivalLink, ['menuLabel', 'title'], lang) || festival.name, order: festivalLink.order }]
    : []
  : [{ path: '/festival/', label: festival.name, order: -Infinity }];
// Both menus start with Home. The way from the festival up to the community site is the
// logo and name in the footer.
const nav = inFestival
  ? [{ path: '/festival/', label: t.home }, ...menuPages]
  : [{ path: '/', label: t.home }, ...[...festivalItem, ...menuPages].sort((a, b) => a.order - b.order)];

const brandPath = inFestival ? '/festival/' : '/';
// The palette as CSS: each colour as --c-<id> and --c-<id>-text, the bands and page colours
// that use it, and the old names (--red, --gold, ...) the stylesheet uses. On community pages
// Festival red and Cream show as Mustard and Light cream (as they always did).
const palette = getPalette();
const paletteCss =
  'html:root{' +
  palette.map((c) => `--c-${c.id}:${c.code};--c-${c.id}-text:${c.text};`).join('') +
  '--red:var(--c-red);--gold:var(--c-gold);--cream:var(--c-cream);--dark:var(--c-dark)}' +
  'body.in-community{--c-red:var(--c-gold);--c-red-text:var(--c-gold-text);--c-cream:var(--c-light);--c-cream-text:var(--c-light-text);--red:var(--c-gold);--cream:var(--c-light)}' +
  palette.map((c) => `body .bg-${c.id},body main.tone-${c.id}{background-color:var(--c-${c.id});color:var(--c-${c.id}-text)}`).join('');
// The top bar and the language list, from Site settings → Colours (else the usual colours).
const colourVars = (id: string | undefined, prefix: string) => (id ? `--${prefix}-bg:var(--c-${id});--${prefix}-text:var(--c-${id}-text)` : undefined);
const headerStyle = colourVars(knownColour(inFestival ? site.festivalHeaderColour : site.communityHeaderColour), 'header');
const langListStyle = colourVars(knownColour(inFestival ? site.festivalLanguageListColour : site.communityLanguageListColour), 'langlist');
// The community logo: from "Community home page", else the round Forró Budapest logo. Used in
// the community top bar and, on every page, in the footer.
const communityLogoField = getImage(community.logo) ? community.logo : '/uploads/forro-budapest-logo.png';
const footerLogo = getImage(communityLogoField);
// The top bar uses the small logo; without one, the big banner logo.
// Community pages: the logo from "Community home page", else the round Forró Budapest logo.
const headerLogoField = inFestival
  ? getImage(festival.headerLogo)
    ? festival.headerLogo
    : festival.logo
  : communityLogoField;
const logo = getImage(headerLogoField);
const ticketUrl = inFestival ? safeUrl(festival.ticketUrl) : '';
const headerDate = inFestival ? tr(festival, 'dateLine', lang) : '';
const instagram = safeUrl((inFestival && festival.instagram) || site.instagram || festival.instagram);
const facebook = safeUrl(site.facebook);
const footerNote = tr(site, 'footerNote', lang);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {desc && <meta name="description" content={desc} />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, pagePath), Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(href(site.defaultLang, pagePath), Astro.site).href} />
    <meta property="og:title" content={fullTitle} />
    {desc && <meta property="og:description" content={desc} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_GB'} />
    {shareUrl && <meta property="og:image" content={shareUrl} />}
    {shareUrl && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content={(palette.find((c) => c.id === (knownColour(inFestival ? site.festivalHeaderColour : site.communityHeaderColour) ?? (inFestival ? 'red' : 'gold'))) ?? palette[0]).code} />
    <style is:inline set:html={paletteCss} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class={inFestival ? 'in-festival' : 'in-community'}>
    <a class="skip" href="#main">{t.skip}</a>

    <header class="top" style={headerStyle}>
      <a class="brand" href={href(lang, brandPath)}>
        {
          logo ? (
            <img src={logo.src} srcset={logo.srcset} sizes="140px" alt={sectionName} class="brand-logo" data-sanity={editAttr(headerLogoField)} />
          ) : (
            <span class="brand-text">{sectionName}</span>
          )
        }
      </a>
      {headerDate && <p class="top-date">{headerDate}</p>}

      <details class="lang" style={langListStyle}>
        <summary aria-label={`${t.language}: ${LANG_NAME[lang]}`}>
          <img src={withBase(`/icons/flag-${lang}.png`)} width="64" height="64" alt="" />
          <span>{LANG_LABEL[lang]}</span>
          <svg class="lang-chevron" viewBox="0 0 16 10" width="16" height="10" aria-hidden="true"><path d="M1 1l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
        </summary>
        <ul class="lang-list">
          {
            LANGS.map((l) => (
              <li>
                <a href={href(l, pagePath)} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
                  <img src={withBase(`/icons/flag-${l}.png`)} width="64" height="64" alt="" />
                  <span>{LANG_NAME[l]}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" hidden>
        <span class="menu-btn-bars" aria-hidden="true"></span>
        <span class="sr-only">{t.menu}</span>
      </button>

      <nav id="menu" class="menu" aria-label={t.menu}>
        {
          nav.map((item) => (
            <a href={href(lang, item.path)} aria-current={item.path === pagePath ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
        {
          ticketUrl && (
            <a class="ticket ticket--small" href={ticketUrl} target="_blank" rel="noopener">
              {t.tickets}
            </a>
          )
        }
      </nav>
      {
        ticketUrl && (
          <a class="ticket ticket--small top-ticket" href={ticketUrl} target="_blank" rel="noopener">
            {t.tickets}
          </a>
        )
      }
    </header>

    <main id="main" class={`tone-${tone}`}>
      <slot />
    </main>

    <footer class="foot">
      <p class="small foot-copy">
        <a class="foot-brand" href={href(lang, '/')}>
          {footerLogo && <img src={footerLogo.src} srcset={footerLogo.srcset} sizes="48px" alt="" />}
          <strong>{site.name}</strong>
        </a>
        <span>© {year}</span>
      </p>
      {
        site.email && (
          <p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        )
      }
      {
        (instagram || facebook) && (
          <p class="foot-social">
            {instagram && (
              <a class="foot-icon" href={instagram} target="_blank" rel="noopener">
                <img src={withBase('/icons/instagram.png')} width="39" height="39" alt={t.instagram} />
              </a>
            )}
            {facebook && (
              <a href={facebook} target="_blank" rel="noopener">
                Facebook
              </a>
            )}
          </p>
        )
      }
      {footerNote && <p class="small">{footerNote}</p>}
    </footer>

    <!--
      The menu button. Without JavaScript the button stays hidden and the menu is simply
      always visible, so the site works either way.
    -->
    <script is:inline>
      (function () {
        var btn = document.querySelector('.menu-btn');
        var menu = document.getElementById('menu');
        if (!btn || !menu) return;
        document.documentElement.classList.add('js');
        btn.hidden = false;
        function set(open) {
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          document.documentElement.classList.toggle('menu-open', open);
        }
        btn.addEventListener('click', function () {
          set(btn.getAttribute('aria-expanded') !== 'true');
        });
        // The language list closes on Escape and on a click anywhere else.
        var langBox = document.querySelector('details.lang');
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            if (langBox && langBox.open) {
              langBox.open = false;
              langBox.querySelector('summary').focus();
              return;
            }
            set(false);
            btn.focus();
          }
        });
        document.addEventListener('click', function (e) {
          if (langBox && langBox.open && !langBox.contains(e.target)) langBox.open = false;
        });
      })();
    </script>
    <script is:inline>
      // Event calendar blocks: drop the months that are over (the site is only rebuilt on
      // publish), then show one month at a time with arrows, starting with the current month
      // or the one in the address (#2026-12). Without JavaScript every month is listed.
      (function () {
        var now = new Date();
        var current = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
        document.querySelectorAll('[data-calendar]').forEach(function (box) {
          var months = [].slice.call(box.querySelectorAll('[data-month]')).filter(function (m) {
            if (m.dataset.month >= current) return true;
            m.remove();
            return false;
          });
          box.classList.add('cal-js');
          if (!months.length) {
            box.querySelector('[data-cal-empty]').hidden = false;
            return;
          }
          var title = box.querySelector('[data-cal-title]');
          var steps = box.querySelectorAll('[data-cal-step]');
          var at = 0;
          function show(i, keepAddress) {
            at = i;
            months.forEach(function (m, j) { m.hidden = j !== i; });
            title.textContent = months[i].querySelector('.cal-month-title').textContent;
            // A missing arrow keeps its place (invisible), so the month name never moves.
            steps[0].classList.toggle('cal-off', i === 0);
            steps[1].classList.toggle('cal-off', i === months.length - 1);
            steps[0].disabled = i === 0;
            steps[1].disabled = i === months.length - 1;
            if (!keepAddress) history.replaceState(null, '', '#' + months[i].dataset.month);
          }
          box.querySelector('[data-cal-nav]').hidden = false;
          var wanted = months.findIndex(function (m) { return '#' + m.dataset.month === location.hash; });
          show(wanted >= 0 ? wanted : 0, true);
          steps.forEach(function (b) {
            b.addEventListener('click', function () { show(at + Number(b.dataset.calStep)); });
          });
        });
      })();
    </script>
    <script is:inline>
      // Photo viewer: a click on a gallery photo or an Image block opens it large, with arrows,
      // swiping, the arrow keys and Escape. A gallery pages through its own photos; Image blocks
      // page through all Image blocks of the page (e.g. the program pictures). Pinch-zoom stays
      // possible. Built on first use; works after the preview swaps the page.
      (function () {
        var box, img, count, list = [], at = 0;
        var svg = function (d) {
          return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + d + '" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>';
        };
        var lang = document.documentElement.lang === 'hu';
        function show(n) {
          at = (n + list.length) % list.length;
          var a = list[at], small = a.querySelector('img');
          // An Image block with a phone version opens that version on narrow screens.
          var phone = a.dataset.phoneSrc && window.matchMedia('(max-width: 719px)').matches;
          img.removeAttribute('srcset');
          var srcset = phone ? a.dataset.phoneSrcset : a.dataset.srcset;
          if (srcset) img.srcset = srcset;
          img.sizes = '100vw';
          img.src = phone ? a.dataset.phoneSrc : a.href;
          img.alt = small ? small.alt : '';
          count.textContent = list.length > 1 ? at + 1 + ' / ' + list.length : '';
          box.querySelector('.lightbox-prev').hidden = box.querySelector('.lightbox-next').hidden = list.length < 2;
        }
        function build() {
          box = document.createElement('dialog');
          box.className = 'lightbox';
          box.innerHTML =
            '<p class="lightbox-count"></p><img alt="">' +
            '<button class="lightbox-close" type="button" aria-label="' + (lang ? 'Bezárás' : 'Close') + '">' + svg('M4 4l16 16M20 4L4 20') + '</button>' +
            '<button class="lightbox-prev" type="button" aria-label="' + (lang ? 'Előző kép' : 'Previous photo') + '">' + svg('M15 3l-9 9 9 9') + '</button>' +
            '<button class="lightbox-next" type="button" aria-label="' + (lang ? 'Következő kép' : 'Next photo') + '">' + svg('M9 3l9 9-9 9') + '</button>';
          document.body.appendChild(box);
          img = box.querySelector('img');
          count = box.querySelector('.lightbox-count');
          box.querySelector('.lightbox-close').onclick = function () { box.close(); };
          box.querySelector('.lightbox-prev').onclick = function () { show(at - 1); };
          box.querySelector('.lightbox-next').onclick = function () { show(at + 1); };
          box.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowLeft') show(at - 1);
            if (e.key === 'ArrowRight') show(at + 1);
          });
          var x0 = null;
          box.addEventListener('touchstart', function (e) {
            var zoomed = window.visualViewport && window.visualViewport.scale > 1.05;
            x0 = e.touches.length === 1 && !zoomed ? e.touches[0].clientX : null;
          }, { passive: true });
          box.addEventListener('touchend', function (e) {
            if (x0 === null) return;
            var dx = e.changedTouches[0].clientX - x0;
            if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1));
            x0 = null;
          });
        }
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a.gallery-open');
          if (!a || e.ctrlKey || e.metaKey || e.shiftKey || !window.HTMLDialogElement) return;
          e.preventDefault();
          if (!box) build();
          var gallery = a.closest('ul.gallery');
          list = Array.prototype.slice.call(
            gallery ? gallery.querySelectorAll('a.gallery-open') : document.querySelectorAll('main a.image-open'),
          ).filter(function (x) { return x.offsetParent !== null; });
          show(list.indexOf(a));
          box.showModal();
        });
      })();
    </script>
  </body>
</html>

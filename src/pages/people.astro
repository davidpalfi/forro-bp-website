---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import { getSite, getPeople } from '../lib/content';

const site = getSite();
const L = site.labels;
const people = await getPeople();

// Teachers, then performers, then organizers, then anyone else.
const groups = [
  { key: 'teacher', heading: L.teachers },
  { key: 'performer', heading: L.performers },
  { key: 'organizer', heading: L.organizers },
]
  .map((g) => ({ ...g, items: people.filter((p) => p.role.toLowerCase() === g.key) }))
  .filter((g) => g.items.length > 0);

const known = new Set(['teacher', 'performer', 'organizer']);
const others = people.filter((p) => !known.has(p.role.toLowerCase()));
if (others.length > 0) groups.push({ key: 'other', heading: L.others, items: others });
---

<Base title={L.people}>
  <section class="page">
    <h1>{L.people}</h1>
    {
      groups.map((g) => (
        <section class="people-group">
          <h2>{g.heading}</h2>
          <ul class="people">
            {g.items.map((p) => (
              <PersonCard person={p} />
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Base>

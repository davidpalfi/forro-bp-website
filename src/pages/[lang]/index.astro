---
// The community home page: the banner (only when a banner photo is set) and the blocks from
// "Community home page".
// The way to the festival is the festival button in the menu.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Blocks from '../../components/Blocks.astro';
import { getSite, getCommunity, getImage } from '../../lib/content';
import { LANGS, tr, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const site = getSite();
const community = getCommunity();
---

<Base lang={lang} section="community" pagePath="/">
  {
    getImage(community.heroImage) ? (
      <Hero image={community.heroImage} title={tr(community, 'title', lang) || site.name} />
    ) : (
      <h1 class="sr-only">{tr(community, 'title', lang) || site.name}</h1>
    )
  }
  <Blocks blocks={community.homeBlocks} lang={lang} tone="red" />
</Base>

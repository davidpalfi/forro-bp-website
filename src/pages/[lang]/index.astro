---
// The community home page: the headline banner (on the banner photo, or on mustard with the
// big logo; can be switched off) and the blocks from "Community home page", on cream by default.
// The way to the festival is the festival button in the menu.
import Base from '../../layouts/Base.astro';
import CommunityHero from '../../components/CommunityHero.astro';
import Blocks from '../../components/Blocks.astro';
import { getSite, getCommunity } from '../../lib/content';
import { LANGS, tr, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const site = getSite();
const community = getCommunity();
---

<Base lang={lang} section="community" pagePath="/" tone="cream">
  {
    community.showHero === false ? (
      <h1 class="sr-only">{tr(community, 'title', lang) || site.name}</h1>
    ) : (
      <CommunityHero
        image={community.heroImage}
        logo={community.logo || '/uploads/forro-budapest-logo.png'}
        title={tr(community, 'title', lang) || site.name}
        subtitle={tr(community, 'subtitle', lang)}
        buttons={community.heroButtons}
        lang={lang}
      />
    )
  }
  <Blocks blocks={community.homeBlocks} lang={lang} tone="cream" />
</Base>

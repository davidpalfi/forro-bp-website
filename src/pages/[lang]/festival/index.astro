---
// The festival home page: the banner from "Festival home page", then its blocks
// (introduction, numbers line, buttons, ...). The ticket button is on the banner.
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import Blocks from '../../../components/Blocks.astro';
import { getFestival, safeUrl } from '../../../lib/content';
import { LANGS, UI, tr, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const festival = getFestival();
const ticketUrl = safeUrl(festival.ticketUrl);
const ticketLabel = tr(festival, 'ticketLabel', lang) || UI[lang].tickets;
---

<Base lang={lang} section="festival" pagePath="/festival/">
  <Hero
    image={festival.heroImage}
    imagePhone={festival.heroImagePhone}
    logo={festival.logo}
    title={festival.name}
    dateLine={tr(festival, 'dateLine', lang)}
    buttonUrl={ticketUrl}
    buttonLabel={ticketLabel}
    buttonNewTab
  />
  <Blocks blocks={festival.homeBlocks} lang={lang} tone="red" />
</Base>

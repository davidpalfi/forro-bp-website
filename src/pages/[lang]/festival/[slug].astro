---
// Every festival page made in the editor (Program, Teachers, Artists, Location, ...).
// Each one gets the address /<language>/festival/<address>/
import PageView from '../../../components/PageView.astro';
import { getPages } from '../../../lib/content';
import { LANGS, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => getPages('festival').map((page) => ({ params: { lang, slug: page.slug } })));
}

// Looked up by address (not passed from getStaticPaths) so the click-to-edit preview,
// which renders on each request, always shows the latest content.
const lang = Astro.params.lang as Lang;
const page = getPages('festival').find((p) => p.slug === Astro.params.slug);
if (!page) return new Response(null, { status: 404 });
---

<PageView page={page} lang={lang} />

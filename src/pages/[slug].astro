---
// Free-form text pages (e.g. Location, Code of conduct), written in the editor
// under "Text pages". Each one gets its own address: /<file-name>/
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { getPages, rebaseHtml } from '../lib/content';

export async function getStaticPaths() {
  // getPages() already leaves out pages whose name clashes with a built-in address.
  const pages = await getPages();
  return pages.map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props;
const { Content } = await render(page.entry);
const html = page.entry.rendered?.html ? rebaseHtml(page.entry.rendered.html) : '';
---

<Base title={page.title}>
  <article class="page prose">
    <h1>{page.title}</h1>
    {page.entry.data.image && <Picture src={page.entry.data.image} class="prose-image" sizes="(min-width: 720px) 720px, 100vw" />}
    {html ? <Fragment set:html={html} /> : <Content />}
  </article>
</Base>

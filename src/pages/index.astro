---
// The bare address "/". Sends the visitor to their language: Hungarian if the browser
// prefers it, otherwise the default language from Site settings. Works without JavaScript too.
import { getSite, withBase } from '../lib/content';
import { LANGS, LANG_NAME } from '../lib/i18n';

const site = getSite();
const target = withBase(`/${site.defaultLang}/`);
---

<!doctype html>
<html lang={site.defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <script is:inline define:vars={{ base: withBase('/'), fallback: site.defaultLang, langs: [...LANGS] }}>
      var prefs = navigator.languages || [navigator.language || ''];
      var pick = fallback;
      for (var i = 0; i < prefs.length; i++) {
        var code = String(prefs[i]).slice(0, 2).toLowerCase();
        if (langs.indexOf(code) !== -1) {
          pick = code;
          break;
        }
      }
      location.replace(base + pick + '/');
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>
      {LANGS.map((l) => <a href={withBase(`/${l}/`)} lang={l}>{LANG_NAME[l]}</a>)}
    </p>
  </body>
</html>

---
// The people cards: photo, role, name, bio, Instagram link. Used by the "People" block.
import Picture from './Picture.astro';
import { paragraphs, safeUrl, withBase, type Person } from '../lib/content';
import { UI, tr, type Lang } from '../lib/i18n';

interface Props {
  people: Person[];
  lang: Lang;
}

const { people, lang } = Astro.props;
---

<ul class="people">
  {
    people.map((p) => {
      const role = tr(p, 'role', lang);
      const bio = paragraphs(tr(p, 'bio', lang));
      const ig = safeUrl(p.instagram);
      return (
        <li class="person">
          {p.photo && <Picture image={p.photo} lang={lang} class="person-photo" sizes="(min-width: 860px) 460px, 100vw" />}
          <div class="person-text">
            {role && <p class="person-role">{role}</p>}
            <h2 class="person-name">{p.name}</h2>
            {bio.map((para) => (
              <p class="person-bio">{para}</p>
            ))}
            {ig && (
              <a class="person-link" href={ig} target="_blank" rel="noopener">
                <img src={withBase('/icons/instagram-gold.png')} width="39" height="39" alt={`${UI[lang].instagram} – ${p.name}`} />
              </a>
            )}
          </div>
        </li>
      );
    })
  }
</ul>

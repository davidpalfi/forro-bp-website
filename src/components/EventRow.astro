---
// One program item. `showDate` puts a big date on the left (home page);
// otherwise the start time is shown (program page, grouped by day).
import { formatDay, safeUrl, type FestivalEvent, type Person } from '../lib/content';

interface Props {
  event: FestivalEvent;
  people: Person[];
  locale: string;
  detailsLabel: string;
  showDate?: boolean;
}

const { event, people, locale, detailsLabel, showDate = false } = Astro.props;

const time = [event.startTime, event.endTime].filter(Boolean).join(' – ');
const weekday = formatDay(event.dateObj, locale, { weekday: 'long' });
const meta = (showDate ? [weekday, time, event.place] : [event.place]).filter(Boolean).join(', ');
const link = safeUrl(event.url);
---

<li class:list={['event', showDate ? 'event--dated' : 'event--timed']} data-day={event.day}>
  <div class="event-when">
    {
      showDate ? (
        <>
          <span class="event-day">{formatDay(event.dateObj, locale, { day: 'numeric' })}</span>
          <span class="event-month">{formatDay(event.dateObj, locale, { month: 'short' })}</span>
        </>
      ) : (
        <span class="event-time">{event.startTime || ''}</span>
      )
    }
  </div>
  <div class="event-body">
    <h3 class="event-title">
      {event.title}
      {event.type && <span class="badge">{event.type}</span>}
    </h3>
    {meta && <p class="event-meta">{meta}</p>}
    {people.length > 0 && <p class="event-people">{people.map((p) => p.name).join(', ')}</p>}
    {event.description && <p class="event-description">{event.description}</p>}
    {
      link && (
        <a class="event-link" href={link} target="_blank" rel="noopener">
          {detailsLabel}
        </a>
      )
    }
  </div>
</li>

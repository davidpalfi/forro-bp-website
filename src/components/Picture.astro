---
// A photo from public/uploads, with web-sized versions when the build made them.
import { getImage } from '../lib/content';

interface Props {
  src?: string;
  alt?: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
}

const { src, alt = '', sizes = '100vw', class: className, eager = false } = Astro.props;
const img = getImage(src);
---

{
  img && (
    <img
      src={img.src}
      srcset={img.srcset}
      sizes={img.srcset ? sizes : undefined}
      width={img.width}
      height={img.height}
      alt={alt}
      class={className}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  )
}

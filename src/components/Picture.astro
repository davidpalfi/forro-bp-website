---
// A photo: from Sanity's image service, or from public/uploads with web-sized versions.
// `image` is whatever the content holds (a Sanity image or an /uploads/ path).
// The editor's focus point keeps the important part visible when the photo is cropped.
// With `phone`, narrow screens (under 720 px) get that photo instead.
import { getImage, altOf, editAttr } from '../lib/content';
import type { Lang } from '../lib/i18n';

interface Props {
  image?: unknown;
  /** Another photo for screens under 720 px wide (the Image block's phone version). */
  phone?: unknown;
  lang?: Lang;
  /** Overrides the description stored with the photo. */
  alt?: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
  /** Click-to-edit target to use instead of the photo's own (preview only), e.g. its whole block. */
  edit?: string;
}

const { image, phone, lang, alt, sizes = '100vw', class: className, eager = false, edit } = Astro.props;
const target = edit ?? editAttr(image);
const img = getImage(image);
const small = img ? getImage(phone) : undefined;
const description = alt ?? (lang ? altOf(image, lang) : '');
---

{
  img && small && (
    <picture>
      <source media="(max-width: 719px)" srcset={small.srcset ?? small.src} sizes="100vw" width={small.width} height={small.height} />
      <img
        src={img.src}
        srcset={img.srcset}
        sizes={img.srcset ? sizes : undefined}
        width={img.width}
        height={img.height}
        alt={description}
        class={className}
        style={img.position ? `object-position: ${img.position}` : undefined}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        data-sanity={target}
      />
    </picture>
  )
}
{
  img && !small && (
    <img
      src={img.src}
      srcset={img.srcset}
      sizes={img.srcset ? sizes : undefined}
      width={img.width}
      height={img.height}
      alt={description}
      class={className}
      style={img.position ? `object-position: ${img.position}` : undefined}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      data-sanity={target}
    />
  )
}

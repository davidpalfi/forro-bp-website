---
// The big banner: photo behind, then logo or name, ticket button and date line.
// An optional second photo is used on phones (the Wix site shows a taller picture there).
// An optional video plays over the photo on computers; the script that starts it is in
// Base.astro. Phones, "reduce motion" and visitors without JavaScript keep the photo.
import { getImage, getVideo, editAttr } from '../lib/content';

interface Props {
  image?: unknown;
  imagePhone?: unknown;
  video?: unknown;
  logo?: unknown;
  title: string;
  dateLine?: string;
  buttonUrl?: string;
  buttonLabel?: string;
  buttonNewTab?: boolean;
}

const { image, imagePhone, video, logo, title, dateLine, buttonUrl, buttonLabel, buttonNewTab = false } = Astro.props;
const main = getImage(image);
const wide = main ?? getImage(imagePhone);
const phone = main ? getImage(imagePhone) : undefined;
const logoImg = getImage(logo);
const clip = getVideo(video);
---

<section class="hero">
  {
    wide && (
      <picture>
        {phone && <source media="(max-width: 719px)" srcset={phone.srcset ?? phone.src} sizes="100vw" />}
        <img
          class="hero-photo"
          src={wide.src}
          srcset={wide.srcset}
          sizes="100vw"
          width={wide.width}
          height={wide.height}
          alt=""
          style={wide.position ? `object-position: ${wide.position}` : undefined}
          loading="eager"
          fetchpriority="high"
          data-sanity={editAttr(main ? image : imagePhone)}
        />
      </picture>
    )
  }
  {
    clip && (
      <video
        class="hero-video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        data-hero-video={clip.src}
        data-type={clip.type}
        data-sanity={editAttr(video)}
      />
    )
  }
  <div class="hero-inner">
    <h1 class="hero-title">
      {
        logoImg ? (
          <img src={logoImg.src} srcset={logoImg.srcset} sizes="(min-width: 720px) 420px, 70vw" alt={title} data-sanity={editAttr(logo)} />
        ) : (
          title
        )
      }
    </h1>
    {
      buttonUrl && buttonLabel && (
        <a class="ticket" href={buttonUrl} target={buttonNewTab ? '_blank' : undefined} rel={buttonNewTab ? 'noopener' : undefined}>
          {buttonLabel}
        </a>
      )
    }
    {dateLine && <p class="hero-date">{dateLine}</p>}
  </div>
</section>

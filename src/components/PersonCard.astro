---
import Picture from './Picture.astro';
import { hostOf, safeUrl, type Person } from '../lib/content';

interface Props {
  person: Person;
}

const { person } = Astro.props;
const link = safeUrl(person.link);
---

<li class="person">
  {
    person.photo ? (
      <Picture
        src={person.photo}
        class="person-photo"
        sizes="(min-width: 720px) 280px, 45vw"
      />
    ) : (
      <div class="person-photo person-photo--empty" aria-hidden="true" />
    )
  }
  <h3 class="person-name">{person.name}</h3>
  {person.country && <p class="person-meta">{person.country}</p>}
  {person.bio && <p class="person-bio">{person.bio}</p>}
  {
    link && (
      <a class="person-link" href={link} target="_blank" rel="noopener">
        {hostOf(link)}
      </a>
    )
  }
</li>
